    {
      "id": "rw-label-main-name",
      "type": "symbol",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "minzoom": 8,
      "filter": [
        "all",
        ["has", "name"],
        ["!=", ["get", "name"], ""],
        ["!=", ["get", "railway"], "service"],
        ["!", ["match", ["get", "service"], ["siding", "yard", "crossing", "crossover", "spur"], true, false]]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "case",
          ["==", ["get", "railway"], "service"],
          "机走线",
          ["coalesce", ["get", "name"], ["get", "ref"], ["get", "operator"]]
