{
  "version": 8,
  "name": "rail_orm_nolabel",
  "sources": {
    "amap": {
      "type": "raster",
      "tiles": [
        "https://webrd01.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}",
        "https://webrd02.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}",
        "https://webrd03.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}",
        "https://webrd04.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}"
      ],
      "tileSize": 256,
      "maxzoom": 18
    },
    "railway": {
      "type": "vector",
      "tiles": ["https://flutter-map.xhcminecraft.top/data/railway/{z}/{x}/{y}.pbf"],
      "minzoom": 0,
      "maxzoom": 18,
      "buffer": 64
    }
  },
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#f7f7f4" } },
    { "id": "amap", "type": "raster", "source": "amap", "paint": { "raster-opacity": 0.85 } },

    {
      "id": "rw-bridge-casing",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["==", ["get", "bridge"], "yes"],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#797979", "line-width": ["interpolate",["linear"],["zoom"],10,3.5,14,5,16,7] }
    },

    {
      "id": "rw-tunnel-base",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["==", ["get", "tunnel"], "yes"],
      "layout": { "line-cap": "butt" },
      "paint": { "line-color": "#ffffff", "line-opacity": 0.6, "line-width": ["interpolate",["linear"],["zoom"],10,2,12,3,15,5,16,6] }
    },

    {
      "id": "rw-casing",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["==", ["get", "railway"], "rail"],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#ffffff", "line-width": ["interpolate",["linear"],["zoom"],7,2,10,3,13,5,16,8] }
    },

    {
      "id": "rw-rail-main",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["all", ["==", ["get", "railway"], "rail"], ["==", ["get", "usage"], "main"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#FF8100", "line-width": ["interpolate",["linear"],["zoom"],7,1.5,10,2.5,13,3.5,16,4.5] }
    },

    {
      "id": "rw-rail-branch",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["all", ["==", ["get", "railway"], "rail"], ["==", ["get", "usage"], "branch"]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#DACA00", "line-width": ["interpolate",["linear"],["zoom"],7,1.5,10,2.5,13,3.5,16,4.5] }
    },

    {
      "id": "rw-rail-other",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["all", ["==", ["get", "railway"], "rail"], ["!", ["match", ["get", "usage"], ["main","branch"], true, false]]],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#444444", "line-width": ["interpolate",["linear"],["zoom"],3.5,0.75,5,1.25,6.5,1.75,8,2.25] }
    },

    {
      "id": "rw-service",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["match", ["get", "service"], ["siding","yard","crossover","spur"], true, false],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#555555", "line-width": ["interpolate",["linear"],["zoom"],5,1,7.5,1.5] }
    },

    {
      "id": "rw-narrow",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["==", ["get", "railway"], "narrow_gauge"],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#000000", "line-width": ["interpolate",["linear"],["zoom"],9,1.5,12,2,16,2.5], "line-dasharray": [3,3] }
    },

    {
      "id": "rw-lightrail",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["==", ["get", "railway"], "light_rail"],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#00BD14", "line-width": ["interpolate",["linear"],["zoom"],10,1.5,13,2.5,16,3.5] }
    },

    {
      "id": "rw-subway",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["==", ["get", "railway"], "subway"],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#0300C3", "line-width": ["interpolate",["linear"],["zoom"],10,1.5,13,2.5,16,3.5] }
    },

    {
      "id": "rw-tram",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["==", ["get", "railway"], "tram"],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#D877B8", "line-width": ["interpolate",["linear"],["zoom"],11,1.5,14,2.5,16,3.5] }
    },

    {
      "id": "rw-construction",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["==", ["get", "railway"], "construction"],
      "layout": { "line-join": "round", "line-cap": "butt" },
      "paint": { "line-color": "#FF8100", "line-width": ["interpolate",["linear"],["zoom"],9,1.5,12,2.5,15,3.5], "line-dasharray": [9,9] }
    },

    {
      "id": "rw-proposed",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["==", ["get", "railway"], "proposed"],
      "layout": { "line-join": "round", "line-cap": "butt" },
      "paint": { "line-color": "#888888", "line-width": ["interpolate",["linear"],["zoom"],9,1.5,12,2.5,15,3.5], "line-dasharray": [2,8] }
    },

    {
      "id": "rw-disused",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["==", ["get", "railway"], "disused"],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#70584D", "line-width": ["interpolate",["linear"],["zoom"],9,1.5,12,2.5,15,3.5] }
    },

    {
      "id": "rw-abandoned",
      "type": "line",
      "source": "railway",
      "source-layer": "rail_gcj_2",
      "filter": ["==", ["get", "railway"], "abandoned"],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#70584D", "line-width": ["interpolate",["linear"],["zoom"],9,1.5,12,2.5,15,3.5], "line-opacity": 0.8, "line-dasharray": [5,5] }
    }
  ]
}